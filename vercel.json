{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm --workspace @nfcompra/web run build",
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ]
}
